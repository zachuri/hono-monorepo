{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Next.js",
	"extends": "@acme/tsconfig/nextjs.json",
	"compilerOptions": {
		"types": ["vitest/globals"],
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			"@acme/ui/*": ["../../packages/ui/src/*"],
			"@acme/utils/*": ["../../packages/utils/src/*"],
			"@acme/app/*": ["../../packages/app/*"],
			"@acme/api/types/*": ["../../packages/api/src/types/*"],
			"@acme/api/*": ["../../packages/api/src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"next.config.js",
		"**/*.js",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		"../../packages/api/worker-configuration.d.ts"
	],
	"exclude": ["node_modules"]
}
