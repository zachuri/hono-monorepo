{
	"name": "@acme/api",
	"version": "0.1.0",
	"scripts": {
		"dev": "bun run docker:up && wrangler dev",
		"build": "bunx tsc --noEmit",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"auth:generate": "bunx --bun @better-auth/cli@latest generate --config src/auth/index.ts --output src/db/auth.schema.ts -y",
		"auth:format": "bunx --bun prettier --write src/db/auth.schema.ts",
		"auth:update": "bun run auth:generate && bun run auth:format",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate:dev": "bunx drizzle-kit migrate",
		"db:migrate:prod": "bunx drizzle-kit migrate",
		"db:studio:dev": "bunx drizzle-kit studio",
		"db:studio:prod": "NODE_ENV=production bunx drizzle-kit studio",
		"docker:up": "docker compose up -d",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f postgres",
		"docker:reset": "docker compose down -v && docker compose up -d",
		"dev:full": "bun run docker:up && bun run dev",
		"clean": "rm -rf .wrangler node_modules"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^4.20250606.0",
		"@hono/zod-openapi": "^1.1.0",
		"@scalar/hono-api-reference": "^0.9.16",
		"better-auth": "^1.2.8",
		"better-auth-cloudflare": "^0.2.4",
		"drizzle-orm": "^0.43.1",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.7.11",
		"http-status": "^2.1.0",
		"postgres": "^3.4.5",
		"tldts": "^7.0.13",
		"toucan-js": "^4.1.1",
		"zod": "^4.1.7",
		"zod-error": "^1.5.0"
	},
	"devDependencies": {
		"@types/node": "^22.15.30",
		"drizzle-kit": "^0.31.1",
		"typescript": "^5.8.3",
		"wrangler": "^4.4.0"
	}
}
