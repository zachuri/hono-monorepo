{
	"extends": "@acme/tsconfig/api.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"types": ["./worker-configuration.d.ts"],
		"paths": {
			"@acme/api/*": ["./src/*"],
			"@acme/app/*": ["../app/*"],
			"@acme/tsconfig": ["../tsconfig/*"]
		}
	}
}
